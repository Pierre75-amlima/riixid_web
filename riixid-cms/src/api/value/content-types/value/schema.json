{
  "kind": "collectionType",
  "collectionName": "values",
  "info": {
    "singularName": "value",
    "pluralName": "values",
    "displayName": "Value"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "subtitle": {
      "type": "text",
      "required": true
    },
    "description": {
      "type": "richtext",
      "required": true
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "orange",
        "white",
        "black"
      ],
      "default": "white"
    }
  }
}
